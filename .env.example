# ═══════════════════════════════════════════════════════════════
#  Sistema de Monitoramento de E-mails — Variáveis de Ambiente
#  Copie este arquivo para .env e preencha os valores
# ═══════════════════════════════════════════════════════════════

# ─── Aplicação ───────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# ─── Segurança ───────────────────────────────────────────────
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-por-uma-segura-em-producao

# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Chave exigida no header X-API-Key para acessar a API/dashboard.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Deixe vazio APENAS em desenvolvimento local (desativa o controle de acesso).
API_ACCESS_KEY=

# ─── Banco de Dados ──────────────────────────────────────────
POSTGRES_PASSWORD=senha_forte_aqui
DATABASE_URL=postgresql+asyncpg://emails_user:senha_forte_aqui@postgres:5432/emails_db

# ─── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_RESULT_BACKEND=redis://redis:6379/1

# ─── Microsoft Outlook / Azure AD ────────────────────────────
# Crie um App Registration no portal.azure.com
# Permissões necessárias: Mail.Read, Mail.ReadWrite (Application)
OUTLOOK_CLIENT_ID=seu-client-id-do-azure
OUTLOOK_CLIENT_SECRET=seu-client-secret-do-azure
OUTLOOK_TENANT_ID=seu-tenant-id-do-azure
OUTLOOK_EMAIL_ADDRESS=usuario@suaempresa.com.br

# ─── WhatsApp ─────────────────────────────────────────────────
# Provedor: 'twilio' ou 'meta'
WHATSAPP_PROVIDER=twilio

# Número que ENVIA as mensagens (formato: +5511999999999)
WHATSAPP_PHONE_NUMBER=+5511999999999

# Número que RECEBE as notificações (seu WhatsApp)
WHATSAPP_TO_NUMBER=+5511888888888

# Twilio (se WHATSAPP_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu-auth-token-twilio

# Meta Business API (se WHATSAPP_PROVIDER=meta)
META_WHATSAPP_PHONE_NUMBER_ID=seu-phone-number-id
META_WHATSAPP_ACCESS_TOKEN=seu-access-token-permanente

# ─── Claude / Anthropic ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6
CLAUDE_MAX_TOKENS=1024

# ─── Sentry (opcional) ───────────────────────────────────────
SENTRY_DSN=

# ─── Processamento ───────────────────────────────────────────
# Intervalo em segundos para verificar novos e-mails (padrão: 60)
CHECK_INTERVAL_SECONDS=60
MAX_EMAILS_PER_BATCH=25
MAX_ATTACHMENT_SIZE_MB=25

# ─── Caminhos ────────────────────────────────────────────────
ATTACHMENTS_BASE_PATH=/app/Emails_Importantes
LOGS_BASE_PATH=/app/logs
LOG_RETENTION_DAYS=90
